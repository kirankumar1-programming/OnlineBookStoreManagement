@model OrderHeader
@{
    ViewData["Title"] = $"Order Details #{Model.Id}";

    // Define tracking status hierarchy
    var status = Model.OrderStatus ?? "Pending";
    int currentStep = status switch
    {
        "Delivered" => 4,
        "Shipped" => 3,
        "Processing" => 2,
        "Cancelled" => 0,
        _ => 1 // Pending
    };

    int progressPercent = currentStep switch
    {
        4 => 100,
        3 => 66,
        2 => 33,
        0 => 0,
        _ => 10 // Pending
    };
}

<div class="mb-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
    <div>
        <a asp-action="Orders" class="text-muted text-decoration-none hover-white">
            <i class="bi bi-arrow-left me-1"></i> Back to Orders History
        </a>
        <h2 class="fw-bold text-white mt-2 mb-0">Order Receipt #@Model.Id</h2>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="DownloadInvoice" asp-route-id="@Model.Id" class="btn btn-primary-gradient fw-bold px-3 py-2">
            <i class="bi bi-file-earmark-pdf me-2"></i> Download PDF Invoice
        </a>
        @switch (Model.OrderStatus)
        {
            case "Pending":
                <span class="badge bg-warning text-dark px-3 py-2 fs-6"><i class="bi bi-clock me-1"></i> Pending</span>
                break;
            case "Processing":
                <span class="badge bg-info text-dark px-3 py-2 fs-6"><i class="bi bi-gear me-1"></i> Processing</span>
                break;
            case "Shipped":
                <span class="badge bg-primary px-3 py-2 fs-6"><i class="bi bi-truck me-1"></i> Shipped</span>
                break;
            case "Delivered":
                <span class="badge bg-success px-3 py-2 fs-6"><i class="bi bi-check-circle me-1"></i> Delivered</span>
                break;
            default:
                <span class="badge bg-danger px-3 py-2 fs-6"><i class="bi bi-x-circle me-1"></i> @Model.OrderStatus</span>
                break;
        }
    </div>
</div>

<!-- Order Tracking Status Timeline Bar -->
<div class="card bg-card border-secondary shadow-lg p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-white mb-0">
            <i class="bi bi-truck-front me-2 text-accent"></i> Order Tracking Pipeline
        </h5>
        <span class="text-muted small">Placed on @Model.OrderDate.ToString("dd MMM yyyy, HH:mm")</span>
    </div>

    @if (status == "Cancelled")
    {
        <div class="alert alert-danger mb-0 border-danger">
            <i class="bi bi-exclamation-octagon me-2"></i> This order was cancelled.
        </div>
    }
    else
    {
        <div class="position-relative my-3 px-2">
            <!-- Progress Line -->
            <div class="progress" style="height: 6px; background-color: rgba(255,255,255,0.1);">
                <div class="progress-bar bg-primary progress-bar-striped progress-bar-animated" role="progressbar" style="width: @(progressPercent)%;" aria-valuenow="@progressPercent" aria-valuemin="0" aria-valuemax="100"></div>
            </div>

            <!-- Steps Icons -->
            <div class="d-flex justify-content-between position-relative mt-n3" style="margin-top: -20px;">
                <!-- Step 1: Pending -->
                <div class="text-center">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center @(currentStep >= 1 ? "bg-primary text-white shadow" : "bg-dark text-muted border border-secondary")" style="width: 36px; height: 36px;">
                        <i class="bi bi-receipt"></i>
                    </div>
                    <div class="mt-2 small fw-bold @(currentStep >= 1 ? "text-white" : "text-muted")">Pending</div>
                    <div class="text-muted extra-small">Order Placed</div>
                </div>

                <!-- Step 2: Processing -->
                <div class="text-center">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center @(currentStep >= 2 ? "bg-primary text-white shadow" : "bg-dark text-muted border border-secondary")" style="width: 36px; height: 36px;">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <div class="mt-2 small fw-bold @(currentStep >= 2 ? "text-white" : "text-muted")">Processing</div>
                    <div class="text-muted extra-small">Packing Items</div>
                </div>

                <!-- Step 3: Shipped -->
                <div class="text-center">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center @(currentStep >= 3 ? "bg-primary text-white shadow" : "bg-dark text-muted border border-secondary")" style="width: 36px; height: 36px;">
                        <i class="bi bi-truck"></i>
                    </div>
                    <div class="mt-2 small fw-bold @(currentStep >= 3 ? "text-white" : "text-muted")">Shipped</div>
                    <div class="text-muted extra-small">Dispatched</div>
                </div>

                <!-- Step 4: Delivered -->
                <div class="text-center">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center @(currentStep >= 4 ? "bg-success text-white shadow" : "bg-dark text-muted border border-secondary")" style="width: 36px; height: 36px;">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div class="mt-2 small fw-bold @(currentStep >= 4 ? "text-white" : "text-muted")">Delivered</div>
                    <div class="text-muted extra-small">Package Delivered</div>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card bg-card border-secondary shadow-lg p-4 mb-4">
            <h5 class="fw-bold text-white mb-4"><i class="bi bi-book me-2 text-primary"></i> Purchased Items</h5>
            
            <div class="table-responsive">
                <table class="table table-custom align-middle">
                    <thead>
                        <tr>
                            <th>Item Details</th>
                            <th class="text-center">Price</th>
                            <th class="text-center">Quantity</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderDetails)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@(string.IsNullOrEmpty(item.Book?.CoverImageUrl) ? "https://via.placeholder.com/50x70" : item.Book.CoverImageUrl)" 
                                             alt="@item.Book?.Title" class="rounded border border-secondary" style="width: 45px; height: 60px; object-fit: cover;" />
                                        <div>
                                            <h6 class="fw-bold text-white mb-0">@item.Book?.Title</h6>
                                            <small class="text-muted">by @item.Book?.Author</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center text-muted font-monospace">₹@item.Price.ToString("N2")</td>
                                <td class="text-center fw-bold font-monospace text-white">@item.Count</td>
                                <td class="text-end fw-bold text-accent font-monospace">₹@((item.Price * item.Count).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end text-white fs-5">Grand Total:</th>
                            <th class="text-end fs-4 fw-extrabold text-accent font-monospace">₹@Model.OrderTotal.ToString("N2")</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card bg-card border-secondary shadow-lg p-4 mb-4">
            <h5 class="fw-bold text-white mb-3"><i class="bi bi-geo-alt me-2 text-accent"></i> Delivery Details</h5>
            
            <p class="text-muted mb-1 small text-uppercase font-monospace">Recipient Name</p>
            <p class="text-white fw-bold mb-3">@Model.Name</p>

            <p class="text-muted mb-1 small text-uppercase font-monospace">Shipping Address</p>
            <p class="text-light mb-3">@Model.StreetAddress<br />@Model.City @Model.PostalCode</p>

            <p class="text-muted mb-1 small text-uppercase font-monospace">Contact Phone</p>
            <p class="text-light mb-4">@Model.PhoneNumber</p>

            <div class="p-3 bg-dark rounded border border-primary">
                <small class="text-primary text-uppercase fw-bold"><i class="bi bi-truck me-1"></i> Shipping &amp; Carrier Info</small>
                <div class="fw-bold text-white mt-1">Carrier: @(string.IsNullOrEmpty(Model.Carrier) ? "Standard Express" : Model.Carrier)</div>
                <div class="font-monospace text-accent">Tracking #: @(string.IsNullOrEmpty(Model.TrackingNumber) ? $"TRK{Model.Id * 884712}" : Model.TrackingNumber)</div>
                @if (Model.ShippingDate != default)
                {
                    <div class="text-muted small mt-1">Dispatched: @Model.ShippingDate.ToString("MMM dd, yyyy")</div>
                }
            </div>

            <div class="mt-4">
                <a asp-action="DownloadInvoice" asp-route-id="@Model.Id" class="btn btn-outline-light w-100 fw-bold py-2">
                    <i class="bi bi-download me-2"></i> Save PDF Invoice
                </a>
            </div>
        </div>
    </div>
</div>
