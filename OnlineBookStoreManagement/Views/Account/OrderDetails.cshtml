@model OrderHeader
@{
    ViewData["Title"] = $"Order Details #{Model.Id}";
}


    


<div class="mb-4 d-flex align-items-center justify-content-between">
    <div>
        <a asp-action="Orders" class="text-muted text-decoration-none hover-white">
            <i class="bi bi-arrow-left me-1"></i> Back to Orders History
        </a>
        <h2 class="fw-bold text-white mt-2 mb-0">Order Receipt #@Model.Id</h2>
    </div>
    <div>
        @switch (Model.OrderStatus)
        {
            case "Pending":
                <span class="badge bg-warning text-dark px-3 py-2 fs-6"><i class="bi bi-clock me-1"></i> Pending</span>
                break;
            case "Processing":
                <span class="badge bg-info text-dark px-3 py-2 fs-6"><i class="bi bi-gear me-1"></i> Processing</span>
                break;
            case "Shipped":
                <span class="badge bg-primary px-3 py-2 fs-6"><i class="bi bi-truck me-1"></i> Shipped</span>
                break;
            default:
                <span class="badge bg-secondary px-3 py-2 fs-6">@Model.OrderStatus</span>
                break;
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card bg-card border-secondary shadow-lg p-4 mb-4">
            <h5 class="fw-bold text-white mb-4"><i class="bi bi-book me-2 text-primary"></i> Purchased Items</h5>
            
            <div class="table-responsive">
                <table class="table table-custom align-middle">
                    <thead>
                        <tr>
                            <th>Item Details</th>
                            <th class="text-center">Price</th>
                            <th class="text-center">Quantity</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderDetails)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@(string.IsNullOrEmpty(item.Book?.CoverImageUrl) ? "https://via.placeholder.com/50x70" : item.Book.CoverImageUrl)" 
                                             alt="@item.Book?.Title" class="rounded border border-secondary" style="width: 45px; height: 60px; object-fit: cover;" />
                                        <div>
                                            <h6 class="fw-bold text-white mb-0">@item.Book?.Title</h6>
                                            <small class="text-muted">by @item.Book?.Author</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center text-muted font-monospace">₹@item.Price.ToString("N2")</td>
                                <td class="text-center fw-bold font-monospace text-white">@item.Count</td>
                                <td class="text-end fw-bold text-accent font-monospace">₹@((item.Price * item.Count).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end text-white fs-5">Grand Total:</th>
                            <th class="text-end fs-4 fw-extrabold text-accent font-monospace">₹@Model.OrderTotal.ToString("N2")</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card bg-card border-secondary shadow-lg p-4 mb-4">
            <h5 class="fw-bold text-white mb-3"><i class="bi bi-geo-alt me-2 text-accent"></i> Delivery Details</h5>
            
            <p class="text-muted mb-1 small text-uppercase font-monospace">Recipient Name</p>
            <p class="text-white fw-bold mb-3">@Model.Name</p>

            <p class="text-muted mb-1 small text-uppercase font-monospace">Shipping Address</p>
            <p class="text-light mb-3">@Model.StreetAddress<br />@Model.City @Model.PostalCode</p>

            <p class="text-muted mb-1 small text-uppercase font-monospace">Contact Phone</p>
            <p class="text-light mb-4">@Model.PhoneNumber</p>

            @if (!string.IsNullOrEmpty(Model.TrackingNumber))
            {
                <div class="p-3 bg-dark rounded border border-primary">
                    <small class="text-primary text-uppercase fw-bold"><i class="bi bi-truck me-1"></i> Tracking Info</small>
                    <div class="fw-bold text-white mt-1">Carrier: @Model.Carrier</div>
                    <div class="font-monospace text-accent">Tracking #: @Model.TrackingNumber</div>
                </div>
            }
        </div>
    </div>
</div>

