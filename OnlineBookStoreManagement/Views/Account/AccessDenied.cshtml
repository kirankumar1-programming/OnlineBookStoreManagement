@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-6 text-center">
        <div class="card bg-card border-danger shadow-lg p-5">
            <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-25 text-danger rounded-circle p-3 mb-3 mx-auto" style="width: 80px; height: 80px;">
                <i class="bi bi-shield-x display-4"></i>
            </div>
            <h2 class="fw-bold text-white mb-2">403 - Access Denied</h2>
            <p class="text-muted mb-4">You do not have permission to view or manage this resource. This action requires <strong class="text-light">Administrator</strong> privileges.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary-gradient px-4 py-2.5 fw-bold">
                <i class="bi bi-house me-2"></i> Return to Home Page
            </a>
        </div>
    </div>
</div>