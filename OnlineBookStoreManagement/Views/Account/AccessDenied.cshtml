@page
@model OnlineBookStoreManagement.Views.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="text-center mt-5">
    <h1 class="text-danger font-weight-bold">🚫 403 - Access Denied</h1>
    <p class="lead text-secondary">You do not have permission to view or manage this resource.</p>
    <p>This action requires <strong>Administrator</strong> privileges.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Return to Home Page</a>
</div>