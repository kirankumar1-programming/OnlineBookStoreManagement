@model OnlineBookStoreManagement.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-6">
        <div class="card bg-card border-secondary shadow-lg p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-primary-glow text-primary rounded-circle p-3 mb-2">
                    <i class="bi bi-person-plus fs-2"></i>
                </div>
                <h3 class="fw-bold text-white mb-1">Create an Account</h3>
                <p class="text-muted">Join BookVerse to order books &amp; track shipments</p>
            </div>

            <form asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="FullName" class="form-label text-muted fw-semibold"></label>
                        <input asp-for="FullName" class="form-control form-control-custom" placeholder="Jane Doe" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Email" class="form-label text-muted fw-semibold"></label>
                        <input asp-for="Email" class="form-control form-control-custom" placeholder="jane@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label text-muted fw-semibold"></label>
                        <input asp-for="Password" class="form-control form-control-custom" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label text-muted fw-semibold"></label>
                        <input asp-for="ConfirmPassword" class="form-control form-control-custom" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="City" class="form-label text-muted fw-semibold"></label>
                        <input asp-for="City" class="form-control form-control-custom" placeholder="Springfield" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PostalCode" class="form-label text-muted fw-semibold"></label>
                        <input asp-for="PostalCode" class="form-control form-control-custom" placeholder="62701" />
                    </div>

                    <div class="col-12">
                        <label asp-for="Address" class="form-label text-muted fw-semibold"></label>
                        <input asp-for="Address" class="form-control form-control-custom" placeholder="456 Maple Avenue" />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary-gradient w-100 py-3 fw-bold mt-4 mb-3">
                    Register Account
                </button>
            </form>

            <div class="text-center text-muted">
                <small>Already registered? <a asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="text-accent fw-bold text-decoration-none">Sign In</a></small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

