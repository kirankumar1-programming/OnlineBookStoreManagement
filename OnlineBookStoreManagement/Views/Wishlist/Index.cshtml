@using OnlineBookStoreManagement.Models.ViewModels
@model WishlistViewModel
@{
    ViewData["Title"] = "My Wishlist";
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-white mb-1">
            <i class="bi bi-heart-fill me-2 text-danger"></i> My Wishlist
        </h2>
        <p class="text-muted mb-0">Saved books you're interested in purchasing or reading later.</p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary-outline btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Continue Shopping
        </a>
        <a asp-controller="Cart" asp-action="Index" class="btn btn-secondary-outline btn-sm">
            <i class="bi bi-cart3 me-1"></i> View Cart
        </a>
    </div>
</div>

@if (!Model.WishlistItems.Any())
{
    <div class="card p-5 text-center bg-card border-secondary shadow-lg my-4">
        <i class="bi bi-bookmark-heart display-1 text-muted mb-3"></i>
        <h3 class="text-white">Your Wishlist is Empty</h3>
        <p class="text-muted">Save books you love by clicking the heart icon on any book card or details page.</p>
        <div class="mt-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary-gradient px-4 py-2">
                <i class="bi bi-grid me-1"></i> Explore Bookstore Catalog
            </a>
        </div>
    </div>
}
else
{
    <!-- Wishlist Stats & Bulk Actions Toolbar -->
    <div class="card bg-dark border-secondary p-3 mb-4 shadow-sm">
        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="d-flex flex-wrap align-items-center gap-3">
                <span class="text-light">
                    <strong>@Model.TotalItems</strong> @(Model.TotalItems == 1 ? "book" : "books") saved
                </span>
                <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                    <i class="bi bi-check-circle me-1"></i> @Model.InStockItemsCount In Stock
                </span>
                @if (Model.OutOfStockItemsCount > 0)
                {
                    <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">
                        <i class="bi bi-x-circle me-1"></i> @Model.OutOfStockItemsCount Out of Stock
                    </span>
                }
                <span class="text-muted small d-none d-sm-inline">
                    Est. Total: <strong class="text-accent font-monospace">₹@Model.TotalEstimatedValue.ToString("N2")</strong>
                </span>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                @if (Model.InStockItemsCount > 0)
                {
                    <form asp-action="MoveAllToCart" method="post" class="d-inline">
                        <button type="submit" class="btn btn-primary-gradient btn-sm fw-bold">
                            <i class="bi bi-cart-plus-fill me-1"></i> Move All In-Stock to Cart
                        </button>
                    </form>
                }
                <form asp-action="Clear" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to clear your entire wishlist?');">
                    <button type="submit" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-trash3 me-1"></i> Clear Wishlist
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Wishlist Items Table -->
    <div class="card bg-card border-secondary shadow-lg overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th>Book Information</th>
                        <th class="text-center">Price</th>
                        <th class="text-center">Availability</th>
                        <th class="text-center">Date Saved</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.WishlistItems)
                    {
                        var book = item.Book;
                        var isOutOfStock = book == null || book.StockQuantity <= 0;

                        <tr class="@(isOutOfStock ? "opacity-75 bg-dark bg-opacity-25" : "")">
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <a asp-controller="Home" asp-action="Details" asp-route-id="@item.BookId">
                                        <img src="@(string.IsNullOrEmpty(book?.CoverImageUrl) ? "/images/default-book.svg" : book.CoverImageUrl)" 
                                             alt="@book?.Title" class="rounded border border-secondary" style="width: 55px; height: 75px; object-fit: cover;"
                                             onerror="this.onerror=null; this.src='/images/default-book.svg';" />
                                    </a>
                                    <div>
                                        <a asp-controller="Home" asp-action="Details" asp-route-id="@item.BookId" class="text-white text-decoration-none hover-white">
                                            <h6 class="fw-bold mb-1">@book?.Title</h6>
                                        </a>
                                        <small class="text-muted d-block mb-1">by @book?.Author</small>
                                        @if (book?.Category != null)
                                        {
                                            <span class="badge bg-primary bg-opacity-75 text-white" style="font-size: 0.72rem;">@book.Category.Name</span>
                                        }
                                        @if (book != null && book.ReviewCount > 0)
                                        {
                                            <span class="text-warning small ms-2">
                                                <i class="bi bi-star-fill"></i> @book.AverageRating
                                            </span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="text-center fw-bold text-accent align-middle font-monospace fs-6">
                                ₹@(book?.Price.ToString("N2") ?? "0.00")
                            </td>
                            <td class="text-center align-middle">
                                @if (isOutOfStock)
                                {
                                    <span class="badge bg-danger text-white px-2 py-1">
                                        <i class="bi bi-x-circle me-1"></i> Out of Stock
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success text-white px-2 py-1">
                                        <i class="bi bi-check-circle me-1"></i> In Stock (@book?.StockQuantity)
                                    </span>
                                }
                            </td>
                            <td class="text-center align-middle text-muted small">
                                @item.CreatedAt.ToString("MMM dd, yyyy")
                            </td>
                            <td class="text-end align-middle">
                                <div class="d-inline-flex align-items-center gap-2">
                                    @if (!isOutOfStock)
                                    {
                                        <form asp-action="MoveToCart" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-primary-gradient btn-sm text-nowrap fw-semibold" title="Move this book directly to your cart">
                                                <i class="bi bi-cart-plus-fill me-1"></i> Move to Cart
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary btn-sm disabled opacity-50 text-nowrap" disabled title="Item is currently out of stock">
                                            <i class="bi bi-slash-circle me-1"></i> Out of Stock
                                        </button>
                                    }

                                    <form asp-action="Remove" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm text-danger hover-white border-0 bg-transparent p-1" title="Remove from Wishlist">
                                            <i class="bi bi-trash3 fs-5"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
