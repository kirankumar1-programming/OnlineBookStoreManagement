@model OnlineBookStoreManagement.Models.OrderHeader
@{
    ViewData["Title"] = $"Order #{Model.Id} Details";
    var statuses = new string[] { "Pending", "Processing", "Shipped", "Delivered", "Cancelled" };

    var status = Model.OrderStatus ?? "Pending";
    int currentStep = status switch
    {
        "Delivered" => 4,
        "Shipped" => 3,
        "Processing" => 2,
        "Cancelled" => 0,
        _ => 1
    };

    int progressPercent = currentStep switch
    {
        4 => 100,
        3 => 66,
        2 => 33,
        0 => 0,
        _ => 10
    };
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <a asp-action="Orders" class="text-decoration-none text-muted mb-2 d-inline-block fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Back to Orders List
        </a>
        <h2 class="fw-bold text-white mb-1">
            <i class="bi bi-receipt me-2 text-accent"></i> Order Reference #@Model.Id
        </h2>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="DownloadInvoice" asp-route-id="@Model.Id" class="btn btn-primary-gradient fw-bold px-3 py-2">
            <i class="bi bi-file-earmark-pdf me-2"></i> Download PDF Invoice
        </a>
        <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill">
            Status: @Model.OrderStatus
        </span>
    </div>
</div>

<!-- Order Tracking Status Timeline Bar -->
<div class="card bg-card border-secondary shadow-lg p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-white mb-0">
            <i class="bi bi-truck-front me-2 text-accent"></i> Live Tracking Progress
        </h5>
        <span class="text-muted small">Order Placed: @Model.OrderDate.ToString("dd MMM yyyy, HH:mm") UTC</span>
    </div>

    @if (status == "Cancelled")
    {
        <div class="alert alert-danger mb-0 border-danger">
            <i class="bi bi-exclamation-octagon me-2"></i> Order Cancelled
        </div>
    }
    else
    {
        <div class="position-relative my-3 px-2">
            <!-- Progress Line -->
            <div class="progress" style="height: 6px; background-color: rgba(255,255,255,0.1);">
                <div class="progress-bar bg-primary progress-bar-striped progress-bar-animated" role="progressbar" style="width: @(progressPercent)%;" aria-valuenow="@progressPercent" aria-valuemin="0" aria-valuemax="100"></div>
            </div>

            <!-- Steps Icons -->
            <div class="d-flex justify-content-between position-relative mt-n3" style="margin-top: -20px;">
                <div class="text-center">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center @(currentStep >= 1 ? "bg-primary text-white shadow" : "bg-dark text-muted border border-secondary")" style="width: 36px; height: 36px;">
                        <i class="bi bi-receipt"></i>
                    </div>
                    <div class="mt-2 small fw-bold @(currentStep >= 1 ? "text-white" : "text-muted")">Pending</div>
                </div>

                <div class="text-center">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center @(currentStep >= 2 ? "bg-primary text-white shadow" : "bg-dark text-muted border border-secondary")" style="width: 36px; height: 36px;">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <div class="mt-2 small fw-bold @(currentStep >= 2 ? "text-white" : "text-muted")">Processing</div>
                </div>

                <div class="text-center">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center @(currentStep >= 3 ? "bg-primary text-white shadow" : "bg-dark text-muted border border-secondary")" style="width: 36px; height: 36px;">
                        <i class="bi bi-truck"></i>
                    </div>
                    <div class="mt-2 small fw-bold @(currentStep >= 3 ? "text-white" : "text-muted")">Shipped</div>
                </div>

                <div class="text-center">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center @(currentStep >= 4 ? "bg-success text-white shadow" : "bg-dark text-muted border border-secondary")" style="width: 36px; height: 36px;">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div class="mt-2 small fw-bold @(currentStep >= 4 ? "text-white" : "text-muted")">Delivered</div>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-4">
    <!-- Left Column: Customer & Order Details -->
    <div class="col-lg-8">
        <!-- Order Items -->
        <div class="card bg-card border-secondary shadow-lg mb-4">
            <div class="card-header border-secondary bg-dark py-3">
                <h5 class="card-title text-white mb-0"><i class="bi bi-bag me-2 text-primary"></i> Ordered Books</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-custom align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Book Details</th>
                            <th class="text-center">Quantity</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.OrderDetails)
                        {
                            var book = detail.Book;
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@(string.IsNullOrEmpty(book?.CoverImageUrl) ? "/images/default-book.png" : book.CoverImageUrl)"
                                             alt="@book?.Title" style="width: 45px; height: 60px; object-fit: cover;" class="rounded border border-secondary" />
                                        <div>
                                            <h6 class="fw-bold text-white mb-0">@(book?.Title ?? "Book Item")</h6>
                                            <small class="text-muted">by @(book?.Author ?? "Unknown Author")</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center font-monospace fw-bold text-white">@detail.Count</td>
                                <td class="text-end text-light">₹@detail.Price.ToString("F2")</td>
                                <td class="text-end fw-bold text-accent">₹@((detail.Price * detail.Count).ToString("F2"))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="bg-dark">
                            <td colspan="3" class="text-end fw-bold text-white">Grand Total:</td>
                            <td class="text-end fw-bold text-accent fs-5">₹@Model.OrderTotal.ToString("F2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- Customer & Shipping Info -->
        <div class="card bg-card border-secondary shadow-lg">
            <div class="card-header border-secondary bg-dark py-3">
                <h5 class="card-title text-white mb-0"><i class="bi bi-person-lines-fill me-2 text-info"></i> Customer &amp; Shipping Details</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="text-muted small fw-bold">CUSTOMER NAME</label>
                        <p class="fw-semibold text-white mb-0">@Model.Name</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small fw-bold">CUSTOMER EMAIL</label>
                        <p class="fw-semibold text-white mb-0"><i class="bi bi-envelope me-1 text-primary"></i>@(Model.User?.Email ?? "N/A")</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small fw-bold">PHONE NUMBER</label>
                        <p class="fw-semibold text-white mb-0"><i class="bi bi-telephone me-1 text-success"></i>@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not Provided" : Model.PhoneNumber)</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small fw-bold">ORDER DATE</label>
                        <p class="fw-semibold text-white mb-0">@Model.OrderDate.ToString("dd MMMM yyyy, HH:mm") UTC</p>
                    </div>
                    <div class="col-12">
                        <label class="text-muted small fw-bold">SHIPPING ADDRESS</label>
                        <p class="fw-semibold text-white mb-0">@Model.StreetAddress, @Model.City - @Model.PostalCode</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Order Status & Tracking Management Form -->
    <div class="col-lg-4">
        <div class="card bg-card border-secondary shadow-lg sticky-top" style="top: 80px;">
            <div class="card-header border-secondary bg-dark py-3">
                <h5 class="card-title text-white mb-0">
                    <i class="bi bi-gear-fill me-2 text-warning"></i> Manage Order &amp; Tracking
                </h5>
            </div>
            <div class="card-body">
                <div class="alert alert-info border-info py-2 small mb-3">
                    <i class="bi bi-envelope-paper me-1"></i> Saving status will automatically dispatch an email notification to the customer.
                </div>

                <form asp-action="UpdateOrderStatus" method="post">
                    <input type="hidden" name="orderId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label text-light fw-semibold">Order Status</label>
                        <select name="orderStatus" class="form-select bg-dark text-white border-secondary">
                            @foreach (var s in statuses)
                            {
                                <option value="@s" selected="@(Model.OrderStatus == s ? "selected" : null)">@s</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-light fw-semibold">Payment Status</label>
                        <input type="text" name="paymentStatus" value="@Model.PaymentStatus" class="form-control bg-dark text-white border-secondary" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-light fw-semibold">Courier / Carrier</label>
                        <input type="text" name="carrier" value="@Model.Carrier" placeholder="e.g., BlueDart, FedEx, DHL" class="form-control bg-dark text-white border-secondary" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-light fw-semibold">Tracking Number</label>
                        <input type="text" name="trackingNumber" value="@Model.TrackingNumber" placeholder="e.g., TRK123456789" class="form-control bg-dark text-white border-secondary" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-light fw-semibold">Dispatch Date</label>
                        <input type="date" name="shippingDate" value="@(Model.ShippingDate != default ? Model.ShippingDate.ToString("yyyy-MM-dd") : "")" class="form-control bg-dark text-white border-secondary" />
                    </div>

                    <button type="submit" class="btn btn-primary-gradient w-100 py-2.5 fw-bold mb-3">
                        <i class="bi bi-save me-2"></i> Save &amp; Notify Customer
                    </button>
                </form>

                <hr class="border-secondary my-3" />

                <a asp-action="DownloadInvoice" asp-route-id="@Model.Id" class="btn btn-outline-info w-100 fw-bold py-2">
                    <i class="bi bi-file-earmark-pdf me-2"></i> Download Official PDF Invoice
                </a>
            </div>
        </div>
    </div>
</div>
