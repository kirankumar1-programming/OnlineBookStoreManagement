@model OnlineBookStoreManagement.Models.ViewModels.LowStockReportViewModel
@{
    ViewData["Title"] = "Low-Stock Admin Digest";
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
    <div>
        <h2 class="fw-bold text-white mb-1">
            <i class="bi bi-bell-fill me-2 text-warning"></i> Low-Stock Admin Digest Report
        </h2>
        <p class="text-muted mb-0">Daily inventory alert digest for store administrators listing out-of-stock and low-stock titles.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <form asp-action="SendLowStockDigest" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="threshold" value="@Model.Threshold" />
            <button type="submit" class="btn btn-warning fw-bold shadow-sm" onclick="return confirm('Send the low-stock daily digest email to all store admins now?');">
                <i class="bi bi-send-fill me-1"></i> Send Daily Digest Email Now
            </button>
        </form>
        <a asp-controller="Books" asp-action="Index" class="btn btn-outline-primary fw-bold">
            <i class="bi bi-box-seam me-1"></i> Manage Inventory
        </a>
    </div>
</div>

<!-- Summary Metrics Cards Row -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card bg-card border-danger shadow-sm h-100">
            <div class="card-body p-3 text-center">
                <small class="text-danger fw-bold text-uppercase d-block mb-1">Out of Stock</small>
                <h3 class="fw-bold text-white mb-0">@Model.OutOfStockCount</h3>
                <small class="text-muted">Titles with 0 copies</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card bg-card border-warning shadow-sm h-100">
            <div class="card-body p-3 text-center">
                <small class="text-warning fw-bold text-uppercase d-block mb-1">Low Stock</small>
                <h3 class="fw-bold text-white mb-0">@Model.LowStockCount</h3>
                <small class="text-muted">Stock &le; @Model.Threshold copies</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card bg-card border-secondary shadow-sm h-100">
            <div class="card-body p-3 text-center">
                <small class="text-accent fw-bold text-uppercase d-block mb-1">Total Alert Items</small>
                <h3 class="fw-bold text-white mb-0">@Model.TotalAlertCount</h3>
                <small class="text-muted">Out of @Model.TotalBooks catalog books</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card bg-card border-secondary shadow-sm h-100">
            <div class="card-body p-3 text-center">
                <small class="text-info fw-bold text-uppercase d-block mb-1">Admin Recipients</small>
                <h3 class="fw-bold text-white mb-0">@Model.AdminRecipients.Count</h3>
                <small class="text-muted">Active admin emails</small>
            </div>
        </div>
    </div>
</div>

<!-- Threshold Filter & Status Bar -->
<div class="card bg-card border-secondary shadow mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="LowStockDigest" class="row g-2 align-items-center">
            <div class="col-auto">
                <label for="threshold" class="col-form-label text-light fw-semibold">
                    <i class="bi bi-funnel me-1 text-primary"></i> Stock Alert Threshold:
                </label>
            </div>
            <div class="col-auto">
                <select id="threshold" name="threshold" class="form-select bg-dark text-white border-secondary" onchange="this.form.submit()">
                    <option value="3" selected="@(Model.Threshold == 3)">&le; 3 Copies</option>
                    <option value="5" selected="@(Model.Threshold == 5)">&le; 5 Copies (Default)</option>
                    <option value="10" selected="@(Model.Threshold == 10)">&le; 10 Copies</option>
                    <option value="15" selected="@(Model.Threshold == 15)">&le; 15 Copies</option>
                    <option value="20" selected="@(Model.Threshold == 20)">&le; 20 Copies</option>
                </select>
            </div>
            <div class="col-auto ms-auto text-muted small">
                <i class="bi bi-clock-history me-1"></i> Report Generated: @Model.GeneratedAt.ToString("dd MMM yyyy, hh:mm tt") UTC
            </div>
        </form>
    </div>
</div>

<!-- Out of Stock Titles Table -->
<div class="card bg-card border-secondary shadow-lg overflow-hidden mb-4">
    <div class="card-header bg-dark border-secondary py-3 d-flex align-items-center justify-content-between">
        <h5 class="card-title text-white mb-0">
            <i class="bi bi-x-circle me-2 text-danger"></i> Out-of-Stock Titles (@Model.OutOfStockCount)
        </h5>
        <span class="badge bg-danger text-white fw-bold px-3 py-1.5 rounded-pill shadow-sm">Action Required</span>
    </div>
    <div class="card-body p-0">
        @if (Model.OutOfStockBooks.Any())
        {
            <div class="table-responsive">
                <table class="table table-custom align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width: 70px;">Cover</th>
                            <th style="width: 30%;">Book Details</th>
                            <th style="width: 18%;">Category</th>
                            <th style="width: 18%;">ISBN</th>
                            <th class="text-end" style="width: 14%;">Price</th>
                            <th class="text-center" style="width: 10%;">Stock</th>
                            <th class="text-center" style="width: 10%;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var book in Model.OutOfStockBooks)
                        {
                            <tr>
                                <td>
                                    <div style="width: 42px; height: 56px; background-color: #1e293b; border-radius: 4px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                        <img src="@(string.IsNullOrWhiteSpace(book.CoverImageUrl) ? "/images/default-book.svg" : book.CoverImageUrl)"
                                             alt="@book.Title" width="42" height="56" class="rounded shadow-sm" style="object-fit: cover;"
                                             onerror="this.onerror=null; this.src='/images/default-book.svg';" />
                                    </div>
                                </td>
                                <td>
                                    <h6 class="fw-bold text-white mb-0">@book.Title</h6>
                                    <small class="text-muted">by @book.Author</small>
                                </td>
                                <td>
                                    <span class="badge bg-dark border border-secondary text-accent">
                                        @(book.Category?.Name ?? "Unassigned")
                                    </span>
                                </td>
                                <td><span class="font-monospace text-muted small">@book.ISBN</span></td>
                                <td class="text-end fw-bold text-accent font-monospace">₹@book.Price.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge bg-danger text-white fw-bold px-2.5 py-1">0</span>
                                </td>
                                <td class="text-center">
                                    <a asp-controller="Books" asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-outline-warning" title="Update Stock">
                                        <i class="bi bi-pencil-square"></i> Restock
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-4 text-center text-muted">
                <i class="bi bi-check-circle fs-2 text-success d-block mb-2"></i>
                Great news! There are currently no out-of-stock titles in the bookstore inventory.
            </div>
        }
    </div>
</div>

<!-- Low Stock Titles Table -->
<div class="card bg-card border-secondary shadow-lg overflow-hidden mb-4">
    <div class="card-header bg-dark border-secondary py-3 d-flex align-items-center justify-content-between">
        <h5 class="card-title text-white mb-0">
            <i class="bi bi-exclamation-triangle me-2 text-warning"></i> Low-Stock Titles (&le; @Model.Threshold copies) (@Model.LowStockCount)
        </h5>
        <span class="badge bg-warning text-dark fw-bold px-3 py-1.5 rounded-pill shadow-sm">Replenish Soon</span>
    </div>
    <div class="card-body p-0">
        @if (Model.LowStockBooks.Any())
        {
            <div class="table-responsive">
                <table class="table table-custom align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width: 70px;">Cover</th>
                            <th style="width: 30%;">Book Details</th>
                            <th style="width: 18%;">Category</th>
                            <th style="width: 18%;">ISBN</th>
                            <th class="text-end" style="width: 14%;">Price</th>
                            <th class="text-center" style="width: 10%;">Stock</th>
                            <th class="text-center" style="width: 10%;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var book in Model.LowStockBooks)
                        {
                            <tr>
                                <td>
                                    <div style="width: 42px; height: 56px; background-color: #1e293b; border-radius: 4px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                        <img src="@(string.IsNullOrWhiteSpace(book.CoverImageUrl) ? "/images/default-book.svg" : book.CoverImageUrl)"
                                             alt="@book.Title" width="42" height="56" class="rounded shadow-sm" style="object-fit: cover;"
                                             onerror="this.onerror=null; this.src='/images/default-book.svg';" />
                                    </div>
                                </td>
                                <td>
                                    <h6 class="fw-bold text-white mb-0">@book.Title</h6>
                                    <small class="text-muted">by @book.Author</small>
                                </td>
                                <td>
                                    <span class="badge bg-dark border border-secondary text-accent">
                                        @(book.Category?.Name ?? "Unassigned")
                                    </span>
                                </td>
                                <td><span class="font-monospace text-muted small">@book.ISBN</span></td>
                                <td class="text-end fw-bold text-accent font-monospace">₹@book.Price.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge bg-warning text-dark fw-bold px-2.5 py-1 rounded-pill shadow-sm">
                                        @book.StockQuantity Left
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a asp-controller="Books" asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-outline-info" title="Edit Book">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-4 text-center text-muted">
                <i class="bi bi-shield-check fs-2 text-success d-block mb-2"></i>
                All remaining titles have stock quantities above the threshold of @Model.Threshold copies.
            </div>
        }
    </div>
</div>

<!-- Admin Recipients Info Card -->
<div class="card bg-card border-secondary shadow-lg">
    <div class="card-header bg-dark border-secondary py-3">
        <h5 class="card-title text-white mb-0">
            <i class="bi bi-envelope-at me-2 text-info"></i> Daily Email Digest Admin Recipients
        </h5>
    </div>
    <div class="card-body">
        <p class="text-muted small mb-3">
            The automated daily low-stock digest service runs every 24 hours in the background and sends inventory alerts to the following store administrator email address(es):
        </p>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var email in Model.AdminRecipients)
            {
                <span class="badge bg-dark border border-info text-info fs-6 px-3 py-2">
                    <i class="bi bi-person-badge me-1"></i> @email
                </span>
            }
        </div>
    </div>
</div>
