@model IEnumerable<OnlineBookStoreManagement.Models.Coupon>
@{
    ViewData["Title"] = "Promotional Coupons";
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold text-white mb-1">
            <i class="bi bi-ticket-perforated text-success me-2"></i> Promotional Coupons Management
        </h2>
        <p class="text-muted mb-0">Create, edit, and track promotional discount codes, validity windows, and usage limits.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Admin" asp-action="CreateCoupon" class="btn btn-primary-gradient btn-sm fw-bold px-3">
            <i class="bi bi-plus-circle me-1"></i> Create New Coupon
        </a>
    </div>
</div>

<div class="card bg-card border-secondary shadow-lg overflow-hidden">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-ticket-perforated fs-1 text-muted d-block mb-3"></i>
            <h5 class="text-light fw-bold">No Promotional Coupons Found</h5>
            <p class="text-muted">Get started by creating your first promotional discount coupon.</p>
            <a asp-controller="Admin" asp-action="CreateCoupon" class="btn btn-primary-gradient btn-sm fw-bold">
                <i class="bi bi-plus-circle me-1"></i> Create Coupon
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-custom align-middle mb-0">
                <thead>
                    <tr>
                        <th>Code &amp; Description</th>
                        <th>Discount Info</th>
                        <th>Min Order</th>
                        <th>Validity Dates</th>
                        <th>Usage Stats</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var coupon in Model)
                    {
                        var isExpired = coupon.ExpiryDate.HasValue && coupon.ExpiryDate.Value < DateTime.UtcNow;
                        var isUpcoming = coupon.StartDate.HasValue && coupon.StartDate.Value > DateTime.UtcNow;
                        var isLimitReached = coupon.UsageLimit.HasValue && coupon.TimesUsed >= coupon.UsageLimit.Value;
                        var isCurrentlyValid = coupon.IsActive && !isExpired && !isUpcoming && !isLimitReached;

                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-dark border border-secondary text-success font-monospace px-2.5 py-1.5 fs-6 shadow-sm">
                                        <i class="bi bi-tag-fill me-1"></i>@coupon.Code
                                    </span>
                                </div>
                                <small class="text-muted d-block text-truncate" style="max-width: 250px;" title="@coupon.Description">
                                    @coupon.Description
                                </small>
                            </td>
                            <td>
                                @if (coupon.DiscountType.Equals("Percentage", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="fw-bold text-info fs-6">@coupon.DiscountValue% OFF</span>
                                    if (coupon.MaximumDiscountAmount.HasValue)
                                    {
                                        <small class="text-muted d-block">(Cap: ₹@coupon.MaximumDiscountAmount.Value.ToString("N2"))</small>
                                    }
                                }
                                else
                                {
                                    <span class="fw-bold text-success fs-6">₹@coupon.DiscountValue.ToString("N2") OFF</span>
                                    <small class="text-muted d-block">(Fixed Discount)</small>
                                }
                            </td>
                            <td>
                                @if (coupon.MinimumOrderAmount > 0)
                                {
                                    <span class="text-light fw-semibold">₹@coupon.MinimumOrderAmount.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="text-muted fs-7">None</span>
                                }
                            </td>
                            <td>
                                <div class="fs-7">
                                    @if (coupon.StartDate.HasValue)
                                    {
                                        <div class="text-light"><i class="bi bi-calendar-event me-1 text-info"></i>From: @coupon.StartDate.Value.ToString("yyyy-MM-dd HH:mm")</div>
                                    }
                                    @if (coupon.ExpiryDate.HasValue)
                                    {
                                        <div class="@(isExpired ? "text-danger" : "text-light")"><i class="bi bi-clock-history me-1 @(isExpired ? "text-danger" : "text-warning")"></i>Until: @coupon.ExpiryDate.Value.ToString("yyyy-MM-dd HH:mm")</div>
                                    }
                                    @if (!coupon.StartDate.HasValue && !coupon.ExpiryDate.HasValue)
                                    {
                                        <span class="text-muted">Always Valid</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold @(isLimitReached ? "text-warning" : "text-light")">
                                        @coupon.TimesUsed
                                        @if (coupon.UsageLimit.HasValue)
                                        {
                                            <span>/ @coupon.UsageLimit.Value</span>
                                        }
                                    </span>
                                    <small class="text-muted">uses</small>
                                </div>
                                @if (coupon.UsageLimit.HasValue)
                                {
                                    int pct = (int)Math.Min(100, Math.Round((double)coupon.TimesUsed / coupon.UsageLimit.Value * 100));
                                    <div class="progress mt-1" style="height: 4px; width: 80px; background-color: rgba(255,255,255,0.1);">
                                        <div class="progress-bar @(isLimitReached ? "bg-warning" : "bg-success")" role="progressbar" style="width: @pct%;" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                }
                            </td>
                            <td>
                                @if (!coupon.IsActive)
                                {
                                    <span class="badge bg-secondary px-2.5 py-1.5 rounded-pill"><i class="bi bi-dash-circle me-1"></i>Inactive</span>
                                }
                                else if (isExpired)
                                {
                                    <span class="badge bg-danger px-2.5 py-1.5 rounded-pill"><i class="bi bi-x-circle me-1"></i>Expired</span>
                                }
                                else if (isUpcoming)
                                {
                                    <span class="badge bg-warning text-dark px-2.5 py-1.5 rounded-pill"><i class="bi bi-clock me-1"></i>Upcoming</span>
                                }
                                else if (isLimitReached)
                                {
                                    <span class="badge bg-warning text-dark px-2.5 py-1.5 rounded-pill"><i class="bi bi-exclamation-triangle me-1"></i>Limit Reached</span>
                                }
                                else
                                {
                                    <span class="badge bg-success px-2.5 py-1.5 rounded-pill"><i class="bi bi-check-circle me-1"></i>Active</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1">
                                    <form asp-action="ToggleCouponStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@coupon.Id" />
                                        <button type="submit" class="btn btn-sm @(coupon.IsActive ? "btn-outline-warning" : "btn-outline-success")" title="@(coupon.IsActive ? "Deactivate Coupon" : "Activate Coupon")">
                                            <i class="bi @(coupon.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                        </button>
                                    </form>
                                    <a asp-action="EditCoupon" asp-route-id="@coupon.Id" class="btn btn-sm btn-outline-info" title="Edit Coupon">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="DeleteCoupon" asp-route-id="@coupon.Id" class="btn btn-sm btn-outline-danger" title="Delete Coupon">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
