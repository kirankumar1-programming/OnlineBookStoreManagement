@using OnlineBookStoreManagement.Models.ViewModels
@model StoreIndexViewModel
@{
    ViewData["Title"] = "Discover Books";
    bool hasActiveFilters = !string.IsNullOrEmpty(Model.SearchTerm) ||
                            Model.SelectedCategoryIds.Any() ||
                            Model.SelectedAuthors.Any() ||
                            Model.MinPrice.HasValue ||
                            Model.MaxPrice.HasValue ||
                            Model.SelectedRatings.Any();
}

<!-- Hero Banner -->
<div class="hero-banner mb-4">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <span class="badge bg-primary text-uppercase px-3 py-2 rounded-pill mb-3 font-monospace">Discover &amp; Collect</span>
            <h1 class="display-5 fw-extrabold text-white mb-3">Explore World-Class Knowledge &amp; Fiction</h1>
            <p class="lead text-muted mb-4">Browse thousands of curated books across software engineering, timeless classics, sci-fi, and business masterworks.</p>

            <!-- Quick Search Bar -->
            <form method="get" asp-action="Index" class="d-flex gap-2 max-w-xl">
                @foreach (var catId in Model.SelectedCategoryIds)
                {
                    <input type="hidden" name="categoryIds" value="@catId" />
                }
                @foreach (var authorName in Model.SelectedAuthors)
                {
                    <input type="hidden" name="authors" value="@authorName" />
                }
                @foreach (var r in Model.SelectedRatings)
                {
                    <input type="hidden" name="minRatings" value="@r" />
                }
                @if (!string.IsNullOrEmpty(Model.SortBy))
                {
                    <input type="hidden" name="sortBy" value="@Model.SortBy" />
                }
                @if (Model.MinPrice.HasValue)
                {
                    <input type="hidden" name="minPrice" value="@Model.MinPrice" />
                }
                @if (Model.MaxPrice.HasValue)
                {
                    <input type="hidden" name="maxPrice" value="@Model.MaxPrice" />
                }
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control form-control-custom" placeholder="Search by keywords, title, author, description, or ISBN..." />
                </div>
                <button type="submit" class="btn btn-primary-gradient px-4">Search</button>
                @if (hasActiveFilters)
                {
                    <a asp-action="Index" class="btn btn-secondary-outline">Reset All</a>
                }
            </form>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Category & Filter Sidebar Form -->
    <div class="col-lg-3">
        <form method="get" asp-action="Index" id="sidebarFilterForm">
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
            }

            <!-- Multi-Select Category Filter Card -->
            <div class="filter-card mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-white mb-0"><i class="bi bi-funnel me-2 text-accent"></i> Categories</h5>
                    @if (Model.SelectedCategoryIds.Any())
                    {
                        <a href="@Url.Action("Index")@Model.GetQueryString(removeCategoryId: -1)" class="small text-muted text-decoration-none">Clear</a>
                    }
                </div>
                <div class="d-flex flex-column gap-2">
                    @foreach (var cat in Model.Categories)
                    {
                        bool isChecked = Model.SelectedCategoryIds.Contains(cat.Id);
                        <div class="form-check custom-checkbox">
                            <input class="form-check-input" type="checkbox" name="categoryIds" value="@cat.Id" id="cat_@cat.Id"
                                   checked="@isChecked" onchange="this.form.submit()" />
                            <label class="form-check-label text-light cursor-pointer ms-1" for="cat_@cat.Id">
                                @cat.Name
                            </label>
                        </div>
                    }
                </div>
            </div>

            <!-- Multi-Select Author Filter Card -->
            @if (Model.Authors != null && Model.Authors.Any())
            {
                <div class="filter-card mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-white mb-0"><i class="bi bi-person me-2 text-accent"></i> Authors</h5>
                        @if (Model.SelectedAuthors.Any())
                        {
                            <a href="@Url.Action("Index")@Model.GetQueryString(removeAuthor: "ALL_AUTHORS_CLEAR_KEY")" class="small text-muted text-decoration-none">Clear</a>
                        }
                    </div>
                    <div class="d-flex flex-column gap-2 max-h-60 overflow-auto pr-1">
                        @foreach (var authorName in Model.Authors)
                        {
                            bool isChecked = Model.SelectedAuthors.Contains(authorName, StringComparer.OrdinalIgnoreCase);
                            string idSanitized = "author_" + Math.Abs(authorName.GetHashCode());
                            <div class="form-check custom-checkbox">
                                <input class="form-check-input" type="checkbox" name="authors" value="@authorName" id="@idSanitized"
                                       checked="@isChecked" onchange="this.form.submit()" />
                                <label class="form-check-label text-light cursor-pointer ms-1" for="@idSanitized">
                                    @authorName
                                </label>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Multi-Select Rating Filter Card -->
            <div class="filter-card mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-white mb-0"><i class="bi bi-star me-2 text-accent"></i> Customer Rating</h5>
                    @if (Model.SelectedRatings.Any())
                    {
                        <a href="@Url.Action("Index")@Model.GetQueryString(removeRating: -1)" class="small text-muted text-decoration-none">Clear</a>
                    }
                </div>
                <div class="d-flex flex-column gap-2">
                    @foreach (var rating in new[] { 4.0, 3.0, 2.0, 1.0 })
                    {
                        bool isChecked = Model.SelectedRatings.Contains(rating);
                        string rId = "rating_" + (int)rating;
                        <div class="form-check custom-checkbox">
                            <input class="form-check-input" type="checkbox" name="minRatings" value="@rating" id="@rId"
                                   checked="@isChecked" onchange="this.form.submit()" />
                            <label class="form-check-label text-light cursor-pointer ms-1" for="@rId">
                                <span class="text-warning">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        if (s <= rating)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star"></i>
                                        }
                                    }
                                </span>
                                <span class="ms-1 text-light">&amp; Up</span>
                            </label>
                        </div>
                    }
                </div>
            </div>

            <!-- Price Range Filter Card -->
            <div class="filter-card mb-4">
                <h5 class="fw-bold text-white mb-3"><i class="bi bi-cash-stack me-2 text-accent"></i> Price Range (₹)</h5>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small text-muted">Min Price</label>
                        <input type="number" name="minPrice" value="@Model.MinPrice" placeholder="₹0" class="form-control form-control-custom text-center" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">Max Price</label>
                        <input type="number" name="maxPrice" value="@Model.MaxPrice" placeholder="₹2000" class="form-control form-control-custom text-center" />
                    </div>
                </div>
                <button type="submit" class="btn btn-secondary-outline btn-sm w-100">Apply Price Filter</button>
            </div>

            <!-- Sort Filter Card -->
            <div class="filter-card">
                <h5 class="fw-bold text-white mb-3"><i class="bi bi-sort-down me-2 text-accent"></i> Sort Results</h5>
                <select name="sortBy" onchange="this.form.submit()" class="form-select form-select-custom">
                    <option value="">Default Order</option>
                    <option value="newest" selected="@(Model.SortBy == "newest")">Newest Arrivals</option>
                    <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Price: Low to High</option>
                    <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Price: High to Low</option>
                    <option value="rating_desc" selected="@(Model.SortBy == "rating_desc")">Customer Rating: High to Low</option>
                    <option value="most_reviewed" selected="@(Model.SortBy == "most_reviewed")">Most Reviewed</option>
                    <option value="title_asc" selected="@(Model.SortBy == "title_asc")">Title: A to Z</option>
                    <option value="title_desc" selected="@(Model.SortBy == "title_desc")">Title: Z to A</option>
                    <option value="author_asc" selected="@(Model.SortBy == "author_asc")">Author: A to Z</option>
                </select>
            </div>
        </form>
    </div>

    <!-- Book Grid -->
    <div class="col-lg-9">
        <!-- Result count & Active Filter Badges Bar -->
        <div class="card bg-dark border-secondary p-3 mb-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                <p class="text-muted mb-0">Showing <strong>@Model.Books.Count()</strong> of <strong>@Model.TotalItems</strong> books</p>

                @if (hasActiveFilters)
                {
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="small text-muted me-1">Active Filters:</span>

                        @foreach (var catId in Model.SelectedCategoryIds)
                        {
                            var catObj = Model.Categories.FirstOrDefault(c => c.Id == catId);
                            if (catObj != null)
                            {
                                <span class="badge bg-primary text-white d-inline-flex align-items-center gap-1 py-2 px-3">
                                    Category: @catObj.Name
                                    <a href="@Url.Action("Index")@Model.GetQueryString(removeCategoryId: catId)"
                                       class="text-white ms-1 text-decoration-none fw-bold" title="Remove Category">&times;</a>
                                </span>
                            }
                        }

                        @foreach (var authorName in Model.SelectedAuthors)
                        {
                            <span class="badge bg-info text-dark d-inline-flex align-items-center gap-1 py-2 px-3">
                                Author: @authorName
                                <a href="@Url.Action("Index")@Model.GetQueryString(removeAuthor: authorName)"
                                   class="text-dark ms-1 text-decoration-none fw-bold" title="Remove Author">&times;</a>
                            </span>
                        }

                        @foreach (var r in Model.SelectedRatings)
                        {
                            <span class="badge bg-warning text-dark d-inline-flex align-items-center gap-1 py-2 px-3">
                                Rating: @r★ &amp; Up
                                <a href="@Url.Action("Index")@Model.GetQueryString(removeRating: r)"
                                   class="text-dark ms-1 text-decoration-none fw-bold" title="Remove Rating">&times;</a>
                            </span>
                        }

                        @if (!string.IsNullOrEmpty(Model.SearchTerm))
                        {
                            <span class="badge bg-secondary text-white d-inline-flex align-items-center gap-1 py-2 px-3">
                                Keyword: "@Model.SearchTerm"
                                <a href="@Url.Action("Index")@Model.GetQueryString(removeKeyword: true)"
                                   class="text-white ms-1 text-decoration-none fw-bold" title="Remove Keyword">&times;</a>
                            </span>
                        }

                        @if (Model.MinPrice.HasValue || Model.MaxPrice.HasValue)
                        {
                            <span class="badge bg-success text-white d-inline-flex align-items-center gap-1 py-2 px-3">
                                Price: ₹@(Model.MinPrice ?? 0) - ₹@(Model.MaxPrice.HasValue ? Model.MaxPrice.Value.ToString() : "Any")
                                <a href="@Url.Action("Index")@Model.GetQueryString(removePrice: true)"
                                   class="text-white ms-1 text-decoration-none fw-bold" title="Remove Price Filter">&times;</a>
                            </span>
                        }

                        <a asp-action="Index" class="btn btn-outline-danger btn-sm rounded-pill ms-1 py-1 px-2" title="Clear all active filters">
                            <i class="bi bi-x-circle me-1"></i>Clear All
                        </a>
                    </div>
                }
            </div>
        </div>

        @if (!Model.Books.Any())
        {
            <div class="card p-5 text-center bg-dark border-secondary my-4">
                <i class="bi bi-journal-x display-1 text-muted mb-3"></i>
                <h4 class="text-light">No books found matching your criteria</h4>
                <p class="text-muted">Try adjusting your keyword search, author selection, rating threshold, or price range.</p>
                <div class="mt-3">
                    <a asp-action="Index" class="btn btn-primary-gradient">View All Books</a>
                </div>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 mb-4">
                @foreach (var book in Model.Books)
                {
                    bool inWishlist = Model.UserWishlistBookIds.Contains(book.Id);
                    <div class="col">
                        <div class="book-card position-relative">
                            <div class="book-cover-container position-relative">
                                <img src="@(string.IsNullOrEmpty(book.CoverImageUrl) ? "/images/default-book.svg" : book.CoverImageUrl)"
                                     alt="@book.Title" class="book-cover-img" width="300" height="400"
                                     onerror="this.onerror=null; this.src='/images/default-book.svg';" />
                                <span class="category-tag">@book.Category?.Name</span>

                                <form asp-controller="Wishlist" asp-action="Toggle" method="post" class="position-absolute top-0 end-0 m-2 wishlist-toggle-form" style="z-index: 10;">
                                    <input type="hidden" name="bookId" value="@book.Id" />
                                    <button type="submit" class="btn btn-dark btn-sm rounded-circle p-0 d-flex align-items-center justify-content-center shadow-sm border border-secondary wishlist-btn @(inWishlist ? "active text-danger" : "text-light")" 
                                            style="width: 34px; height: 34px; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(8px);" 
                                            title="@(inWishlist ? "Remove from Wishlist" : "Add to Wishlist")" aria-label="Toggle Wishlist">
                                        <i class="bi @(inWishlist ? "bi-heart-fill" : "bi-heart") fs-6"></i>
                                    </button>
                                </form>
                            </div>
                            <div class="book-card-body">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <h5 class="book-title mb-0">@book.Title</h5>
                                </div>
                                <p class="book-author mb-2">by @book.Author</p>

                                <!-- Star Rating Badge -->
                                <div class="mb-3 d-flex align-items-center gap-1">
                                    @if (book.ReviewCount > 0)
                                    {
                                        <div class="text-warning small">
                                            <i class="bi bi-star-fill"></i>
                                            <span class="fw-bold text-white ms-1">@book.AverageRating</span>
                                        </div>
                                        <span class="text-muted small">(@book.ReviewCount reviews)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><i class="bi bi-star me-1"></i> No reviews yet</span>
                                    }
                                </div>

                                <div class="mt-auto pt-2 d-flex align-items-center justify-content-between gap-2">
                                    <div class="min-w-0">
                                        <div class="price-tag">₹@book.Price.ToString("N2")</div>
                                        <small class="@(book.StockQuantity > 0 ? "text-success" : "text-danger") fw-bold text-nowrap d-block">
                                            <i class="bi @(book.StockQuantity > 0 ? "bi-check-circle" : "bi-x-circle") me-1"></i>
                                            @(book.StockQuantity > 0 ? $"{book.StockQuantity} In Stock" : "Out of Stock")
                                        </small>
                                    </div>
                                    <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-secondary-outline btn-sm text-nowrap flex-shrink-0">
                                        Details <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Bookstore Catalog Pagination" class="mt-4">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link bg-dark border-secondary text-light" href="@Url.Action("Index")@Model.GetQueryString(Model.CurrentPage - 1)">Previous</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link @(i == Model.CurrentPage ? "bg-primary border-primary text-white" : "bg-dark border-secondary text-light")"
                                   href="@Url.Action("Index")@Model.GetQueryString(i)">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link bg-dark border-secondary text-light" href="@Url.Action("Index")@Model.GetQueryString(Model.CurrentPage + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).on('submit', '.wishlist-toggle-form', function(e) {
            e.preventDefault();
            var $form = $(this);
            var $btn = $form.find('.wishlist-btn');
            var $icon = $btn.find('i');
            
            $.ajax({
                url: $form.attr('action'),
                type: 'POST',
                data: $form.serialize(),
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function(response) {
                    if (response.requireLogin) {
                        window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname + window.location.search);
                        return;
                    }
                    if (response.success) {
                        if (response.inWishlist) {
                            $btn.addClass('active text-danger').removeClass('text-light');
                            $icon.removeClass('bi-heart').addClass('bi-heart-fill');
                            $btn.attr('title', 'Remove from Wishlist');
                        } else {
                            $btn.removeClass('active text-danger').addClass('text-light');
                            $icon.removeClass('bi-heart-fill').addClass('bi-heart');
                            $btn.attr('title', 'Add to Wishlist');
                        }
                        
                        // Update navbar wishlist badge if present
                        var $badge = $('a[asp-controller="Wishlist"] .badge, a[href*="Wishlist"] .badge');
                        if (response.wishlistCount > 0) {
                            if ($badge.length) {
                                $badge.text(response.wishlistCount);
                            }
                        } else {
                            $badge.remove();
                        }
                    }
                },
                error: function() {
                    // Fallback submit form normally on error
                    $form.off('submit').submit();
                }
            });
        });
    </script>
}
