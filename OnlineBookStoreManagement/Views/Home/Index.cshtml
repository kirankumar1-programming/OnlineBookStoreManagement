@using OnlineBookStoreManagement.Models.ViewModels
@model StoreIndexViewModel
@{
    ViewData["Title"] = "Discover Books";
}

<!-- Hero Banner -->
<div class="hero-banner mb-4">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <span class="badge bg-primary text-uppercase px-3 py-2 rounded-pill mb-3 font-monospace">Discover &amp; Collect</span>
            <h1 class="display-5 fw-extrabold text-white mb-3">Explore World-Class Knowledge &amp; Fiction Testing CI/CD Removed Master Branch test</h1>
            <p class="lead text-muted mb-4">Browse thousands of curated books across software engineering, timeless classics, sci-fi, and business masterworks.</p>

            <!-- Quick Search Bar -->
            <form method="get" asp-action="Index" class="d-flex gap-2 max-w-xl">
                @if (Model.SelectedCategoryId.HasValue)
                {
                    <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                }
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control form-control-custom" placeholder="Search by title, author, or ISBN..." />
                </div>
                <button type="submit" class="btn btn-primary-gradient px-4">Search</button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.SelectedCategoryId.HasValue || Model.MinPrice.HasValue || Model.MaxPrice.HasValue)
                {
                    <a asp-action="Index" class="btn btn-secondary-outline">Reset</a>
                }
            </form>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Category & Filter Sidebar -->
    <div class="col-lg-3">
        <!-- Category Filter -->
        <div class="filter-card mb-4">
            <h5 class="fw-bold text-white mb-3"><i class="bi bi-funnel me-2 text-accent"></i> Categories</h5>
            <div class="list-group list-group-flush bg-transparent">
                <a asp-action="Index" asp-route-searchTerm="@Model.SearchTerm" asp-route-sortBy="@Model.SortBy" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice"
                   class="list-group-item list-group-item-action bg-transparent border-0 text-light rounded mb-1 px-3 py-2 d-flex justify-content-between align-items-center @(!Model.SelectedCategoryId.HasValue ? "bg-primary text-white fw-bold" : "")">
                    <span><i class="bi bi-collection me-2"></i> All Categories</span>
                    <span class="badge bg-dark rounded-pill">@Model.TotalItems</span>
                </a>
                @foreach (var cat in Model.Categories)
                {
                    <a asp-action="Index" asp-route-categoryId="@cat.Id" asp-route-searchTerm="@Model.SearchTerm" asp-route-sortBy="@Model.SortBy" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice"
                       class="list-group-item list-group-item-action bg-transparent border-0 text-light rounded mb-1 px-3 py-2 d-flex justify-content-between align-items-center @(Model.SelectedCategoryId == cat.Id ? "bg-primary text-white fw-bold" : "")">
                        <span>@cat.Name</span>
                    </a>
                }
            </div>
        </div>

        <!-- Price Range Filter Card -->
        <div class="filter-card mb-4">
            <h5 class="fw-bold text-white mb-3"><i class="bi bi-cash-stack me-2 text-accent"></i> Price Range (₹)</h5>
            <form method="get" asp-action="Index">
                @if (Model.SelectedCategoryId.HasValue)
                {
                    <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                }
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                }
                @if (!string.IsNullOrEmpty(Model.SortBy))
                {
                    <input type="hidden" name="sortBy" value="@Model.SortBy" />
                }
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small text-muted">Min Price</label>
                        <input type="number" name="minPrice" value="@Model.MinPrice" placeholder="₹0" class="form-control form-control-custom text-center" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">Max Price</label>
                        <input type="number" name="maxPrice" value="@Model.MaxPrice" placeholder="₹2000" class="form-control form-control-custom text-center" />
                    </div>
                </div>
                <button type="submit" class="btn btn-secondary-outline btn-sm w-100">Apply Price Filter</button>
            </form>
        </div>

        <!-- Sort Filter -->
        <div class="filter-card">
            <h5 class="fw-bold text-white mb-3"><i class="bi bi-sort-down me-2 text-accent"></i> Sort Results</h5>
            <form method="get" asp-action="Index">
                @if (Model.SelectedCategoryId.HasValue)
                {
                    <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                }
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                }
                @if (Model.MinPrice.HasValue)
                {
                    <input type="hidden" name="minPrice" value="@Model.MinPrice" />
                }
                @if (Model.MaxPrice.HasValue)
                {
                    <input type="hidden" name="maxPrice" value="@Model.MaxPrice" />
                }
                <select name="sortBy" onchange="this.form.submit()" class="form-select form-select-custom">
                    <option value="">Default Order</option>
                    <option value="newest" selected="@(Model.SortBy == "newest")">Newest Arrivals</option>
                    <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Price: Low to High</option>
                    <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Price: High to Low</option>
                    <option value="title_asc" selected="@(Model.SortBy == "title_asc")">Title: A to Z</option>
                </select>
            </form>
        </div>
    </div>

    <!-- Book Grid -->
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <p class="text-muted mb-0">Showing <strong>@Model.Books.Count()</strong> of <strong>@Model.TotalItems</strong> books</p>
        </div>

        @if (!Model.Books.Any())
        {
            <div class="card p-5 text-center bg-dark border-secondary my-4">
                <i class="bi bi-journal-x display-1 text-muted mb-3"></i>
                <h4 class="text-light">No books found matching your criteria</h4>
                <p class="text-muted">Try adjusting your search keywords, price range, or clearing category filters.</p>
                <div class="mt-3">
                    <a asp-action="Index" class="btn btn-primary-gradient">View All Books</a>
                </div>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 mb-4">
                @foreach (var book in Model.Books)
                {
                    <div class="col">
                        <div class="book-card">
                            <div class="book-cover-container">
                                <img src="@(string.IsNullOrEmpty(book.CoverImageUrl) ? "/images/default-book.svg" : book.CoverImageUrl)"
                                     alt="@book.Title" class="book-cover-img" width="300" height="400"
                                     onerror="this.onerror=null; this.src='/images/default-book.svg';" />
                                <span class="category-tag">@book.Category?.Name</span>
                            </div>
                            <div class="book-card-body">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <h5 class="book-title mb-0">@book.Title</h5>
                                </div>
                                <p class="book-author mb-2">by @book.Author</p>

                                <!-- Star Rating Badge -->
                                <div class="mb-3 d-flex align-items-center gap-1">
                                    @if (book.ReviewCount > 0)
                                    {
                                        <div class="text-warning small">
                                            <i class="bi bi-star-fill"></i>
                                            <span class="fw-bold text-white ms-1">@book.AverageRating</span>
                                        </div>
                                        <span class="text-muted small">(@book.ReviewCount reviews)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><i class="bi bi-star me-1"></i> No reviews yet</span>
                                    }
                                </div>

                                <div class="mt-auto pt-2 d-flex align-items-center justify-content-between">
                                    <div>
                                        <div class="price-tag">₹@book.Price.ToString("N2")</div>
                                        <small class="@(book.StockQuantity > 0 ? "text-success" : "text-danger") fw-bold">
                                            <i class="bi @(book.StockQuantity > 0 ? "bi-check-circle" : "bi-x-circle") me-1"></i>
                                            @(book.StockQuantity > 0 ? $"{book.StockQuantity} In Stock" : "Out of Stock")
                                        </small>
                                    </div>
                                    <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-secondary-outline btn-sm">
                                        Details <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Bookstore Catalog Pagination" class="mt-4">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-item bg-dark border-secondary text-light page-link" asp-action="Index"
                               asp-route-page="@(Model.CurrentPage - 1)"
                               asp-route-categoryId="@Model.SelectedCategoryId"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-sortBy="@Model.SortBy"
                               asp-route-minPrice="@Model.MinPrice"
                               asp-route-maxPrice="@Model.MaxPrice">Previous</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link @(i == Model.CurrentPage ? "bg-primary border-primary text-white" : "bg-dark border-secondary text-light")"
                                   asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-categoryId="@Model.SelectedCategoryId"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-sortBy="@Model.SortBy"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link bg-dark border-secondary text-light" asp-action="Index"
                               asp-route-page="@(Model.CurrentPage + 1)"
                               asp-route-categoryId="@Model.SelectedCategoryId"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-sortBy="@Model.SortBy"
                               asp-route-minPrice="@Model.MinPrice"
                               asp-route-maxPrice="@Model.MaxPrice">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</div>
