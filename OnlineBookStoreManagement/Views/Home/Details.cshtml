@model OnlineBookStoreManagement.Models.ViewModels.BookDetailsViewModel
@{
    ViewData["Title"] = Model.Book.Title;
}

<div class="mb-3">
    <a asp-action="Index" class="text-muted text-decoration-none hover-white">
        <i class="bi bi-arrow-left me-1"></i> Back to Catalog
    </a>
</div>

<div class="card bg-card border-secondary shadow-lg p-3 p-sm-4 mb-5">
    <div class="row g-4">
        <!-- Cover Image -->
        <div class="col-md-5 col-lg-4 text-center">
            <div class="rounded-3 overflow-hidden border border-secondary shadow-lg">
                <img src="@(string.IsNullOrEmpty(Model.Book.CoverImageUrl) ? "/images/default-book.svg" : Model.Book.CoverImageUrl)" 
                     alt="@Model.Book.Title" class="img-fluid w-100" style="max-height: 480px; object-fit: cover;"
                     onerror="this.onerror=null; this.src='/images/default-book.svg';" />
            </div>
        </div>

        <!-- Book Information -->
        <div class="col-md-7 col-lg-8 d-flex flex-column">
            <div>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="badge bg-primary text-uppercase px-3 py-2">@Model.Book.Category?.Name</span>
                    <span class="badge bg-dark border border-secondary text-muted font-monospace">ISBN: @Model.Book.ISBN</span>
                </div>
                <h1 class="display-6 fw-bold text-white mb-1">@Model.Book.Title</h1>
                <p class="fs-5 text-muted mb-3">by <strong class="text-light">@Model.Book.Author</strong></p>

                <!-- Average Star Rating Banner -->
                <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-2 mb-4 p-3 bg-dark rounded-3 border border-secondary">
                    <div class="d-flex align-items-center gap-2">
                        <div class="d-flex text-warning fs-5 flex-nowrap">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Round(Model.Book.AverageRating))
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star text-muted"></i>
                                }
                            }
                        </div>
                        <span class="fw-bold text-white fs-5">@Model.Book.AverageRating</span>
                    </div>
                    <span class="text-muted small">out of 5 (@Model.Book.ReviewCount @(Model.Book.ReviewCount == 1 ? "review" : "reviews"))</span>
                </div>

                <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-baseline gap-2 mb-4">
                    <div class="fs-2 fw-extrabold text-accent text-nowrap">₹@Model.Book.Price.ToString("N2")</div>
                    @if (Model.Book.StockQuantity > 0)
                    {
                        <span class="badge bg-success-subtle text-success border border-success px-3 py-2 text-wrap">
                            <i class="bi bi-check-circle-fill me-1"></i> In Stock (@Model.Book.StockQuantity copies available)
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger px-3 py-2">
                            <i class="bi bi-x-circle-fill me-1"></i> Out of Stock
                        </span>
                    }
                </div>

                <div class="mb-4">
                    <h5 class="fw-bold text-white mb-2">Overview</h5>
                    <p class="text-light opacity-90 leading-relaxed fs-6">@Model.Book.Description</p>
                </div>
            </div>

            <!-- Add to Cart & Wishlist Actions -->
            <div class="mt-auto pt-3 border-top border-secondary">
                <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-3">
                    @if (Model.Book.StockQuantity > 0)
                    {
                        <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-3 flex-grow-1">
                            <input type="hidden" name="bookId" value="@Model.Book.Id" />
                            <div class="d-flex align-items-center gap-2">
                                <label class="form-label text-muted fw-bold mb-0">Quantity:</label>
                                <input type="number" name="quantity" value="1" min="1" max="@Model.Book.StockQuantity" class="form-control form-control-custom text-center fw-bold" style="width: 80px;" />
                            </div>
                            <button type="submit" class="btn btn-primary-gradient py-2 px-4 flex-grow-1 fw-bold">
                                <i class="bi bi-cart-plus-fill me-2"></i> Add to Cart
                            </button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-secondary disabled opacity-50 px-4 py-2 flex-grow-1">
                            <i class="bi bi-slash-circle me-2"></i> Currently Unavailable
                        </button>
                    }

                    <form asp-controller="Wishlist" asp-action="Toggle" method="post" class="wishlist-toggle-form">
                        <input type="hidden" name="bookId" value="@Model.Book.Id" />
                        <button type="submit" class="btn btn-secondary-outline py-2 px-3 w-100 wishlist-details-btn @(Model.IsInWishlist ? "text-danger border-danger" : "")" 
                                title="@(Model.IsInWishlist ? "Remove from Wishlist" : "Save to Wishlist")">
                            <i class="bi @(Model.IsInWishlist ? "bi-heart-fill text-danger" : "bi-heart") me-2"></i>
                            <span class="wishlist-btn-text">@(Model.IsInWishlist ? "In Wishlist" : "Wishlist")</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Customer Reviews Section -->
<div class="row g-4 mb-5">
    <!-- Reviews List -->
    <div class="col-lg-7">
        <div class="card bg-card border-secondary shadow-lg p-4 h-100">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h4 class="fw-bold text-white mb-0">
                    <i class="bi bi-chat-square-text me-2 text-accent"></i> Customer Reviews
                </h4>
                <span class="badge bg-primary rounded-pill fs-6 px-3 py-2">@Model.Book.Reviews.Count</span>
            </div>

            @if (!Model.Book.Reviews.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-chat-left-dots fs-1 d-block mb-3 opacity-50"></i>
                    <p class="fs-6">No customer reviews yet. Be the first to read and review this book!</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var review in Model.Book.Reviews.OrderByDescending(r => r.ReviewDate))
                    {
                        <div class="p-3 bg-dark rounded-3 border border-secondary">
                            <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-2 mb-2">
                                <div class="d-flex align-items-center gap-2 min-w-0">
                                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 34px; height: 34px; font-weight: 700;">
                                        @(review.User?.FullName?.Substring(0, 1).ToUpper() ?? "C")
                                    </div>
                                    <div class="min-w-0">
                                        <h6 class="fw-bold text-white mb-0 text-truncate">@(review.User?.FullName ?? "Verified Reader")</h6>
                                        <small class="text-muted d-block">@review.ReviewDate.ToString("MMM dd, yyyy")</small>
                                    </div>
                                </div>

                                <div class="text-warning d-flex align-items-center gap-1 text-nowrap flex-shrink-0">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= review.Rating)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star text-muted"></i>
                                        }
                                    }
                                </div>
                            </div>
                            <p class="text-light mb-0">@review.Comment</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Submit Review Form Card -->
    <div class="col-lg-5">
        <div class="card bg-card border-secondary shadow-lg p-4 h-100">
            <h4 class="fw-bold text-white mb-3"><i class="bi bi-star-half me-2 text-warning"></i> Leave a Review</h4>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <form id="addReviewForm" asp-action="AddReview" method="post">
                    <input type="hidden" name="bookId" value="@Model.Book.Id" />

                    <div class="mb-3">
                        <label class="form-label text-muted fw-bold">Your Rating</label>
                        <select name="rating" class="form-select form-select-custom fw-bold text-warning" required>
                            <option value="5">⭐⭐⭐⭐⭐ (5 Stars - Excellent)</option>
                            <option value="4">⭐⭐⭐⭐ (4 Stars - Very Good)</option>
                            <option value="3">⭐⭐⭐ (3 Stars - Good)</option>
                            <option value="2">⭐⭐ (2 Stars - Average)</option>
                            <option value="1">⭐ (1 Star - Poor)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted fw-bold">Your Comment</label>
                        <textarea name="comment" rows="4" class="form-control form-control-custom" placeholder="What did you think of the author's writing style, insights, or story?" required></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary-gradient w-100 py-2 fw-bold">
                        <i class="bi bi-send me-1"></i> Submit Review
                    </button>
                </form>
            }
            else
            {
                <div class="p-4 text-center text-muted bg-dark rounded border border-secondary my-auto">
                    <i class="bi bi-lock fs-2 d-block mb-2 text-warning"></i>
                    <p class="mb-3">Please sign in to leave a review and rating for this book.</p>
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Home/Details/@Model.Book.Id" class="btn btn-secondary-outline btn-sm">
                        Sign In to Review
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Related Books -->
@if (Model.RelatedBooks.Any())
{
    <div class="mt-4">
        <h4 class="fw-bold text-white mb-4"><i class="bi bi-journals me-2 text-primary"></i> You May Also Like</h4>
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var rBook in Model.RelatedBooks)
            {
                <div class="col">
                    <div class="book-card">
                        <div class="book-cover-container" style="height: 180px;">
                            <img src="@(string.IsNullOrEmpty(rBook.CoverImageUrl) ? "https://via.placeholder.com/300x400" : rBook.CoverImageUrl)" alt="@rBook.Title" class="book-cover-img" />
                        </div>
                        <div class="book-card-body p-3">
                            <h6 class="book-title fs-6">@rBook.Title</h6>
                            <p class="book-author small mb-2">@rBook.Author</p>
                            <div class="d-flex align-items-center justify-content-between mt-auto">
                                <span class="fw-bold text-accent">₹@rBook.Price.ToString("N2")</span>
                                <a asp-action="Details" asp-route-id="@rBook.Id" class="btn btn-secondary-outline btn-sm py-1 px-2">View</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).on('submit', '.wishlist-toggle-form', function(e) {
            e.preventDefault();
            var $form = $(this);
            var $btn = $form.find('.wishlist-details-btn');
            var $icon = $btn.find('i');
            var $text = $btn.find('.wishlist-btn-text');
            
            $.ajax({
                url: $form.attr('action'),
                type: 'POST',
                data: $form.serialize(),
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function(response) {
                    if (response.requireLogin) {
                        window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname + window.location.search);
                        return;
                    }
                    if (response.success) {
                        if (response.inWishlist) {
                            $btn.addClass('text-danger border-danger');
                            $icon.removeClass('bi-heart').addClass('bi-heart-fill text-danger');
                            $text.text('In Wishlist');
                            $btn.attr('title', 'Remove from Wishlist');
                        } else {
                            $btn.removeClass('text-danger border-danger');
                            $icon.removeClass('bi-heart-fill text-danger').addClass('bi-heart');
                            $text.text('Wishlist');
                            $btn.attr('title', 'Save to Wishlist');
                        }
                        
                        // Update navbar wishlist badge
                        var $badge = $('a[asp-controller="Wishlist"] .badge, a[href*="Wishlist"] .badge');
                        if (response.wishlistCount > 0) {
                            if ($badge.length) {
                                $badge.text(response.wishlistCount);
                            }
                        } else {
                            $badge.remove();
                        }
                    }
                },
                error: function() {
                    $form.off('submit').submit();
                }
            });
        });
    </script>
}
