@model OnlineBookStoreManagement.Models.Book
@{
    ViewData["Title"] = $"Update - {Model.Title}";
}

<div class="row justify-content-center py-2">
    <div class="col-lg-8">
        <div class="card bg-card border-secondary shadow-lg p-4 p-md-5">
            <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom border-secondary">
                <div>
                    <h3 class="fw-bold text-white mb-1"><i class="bi bi-pencil-square me-2 text-info"></i> Update Book Details</h3>
                    <p class="text-muted small mb-0">Modify information for book #@Model.Id.</p>
                </div>
                <a asp-action="Index" class="btn btn-secondary-outline btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Inventory
                </a>
            </div>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Title" class="form-label text-muted fw-semibold">Book Title</label>
                        <input asp-for="Title" class="form-control form-control-custom" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="CategoryId" class="form-label text-muted fw-semibold">Category</label>
                        <select asp-for="CategoryId" class="form-select form-select-custom" asp-items="ViewBag.Categories" required>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Author" class="form-label text-muted fw-semibold">Author</label>
                        <input asp-for="Author" class="form-control form-control-custom" required />
                        <span asp-validation-for="Author" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ISBN" class="form-label text-muted fw-semibold">ISBN</label>
                        <input asp-for="ISBN" class="form-control form-control-custom font-monospace" required />
                        <span asp-validation-for="ISBN" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label text-muted fw-semibold">Price (₹)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-muted">₹</span>
                            <input asp-for="Price" type="number" step="0.01" class="form-control form-control-custom font-monospace" required />
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="StockQuantity" class="form-label text-muted fw-semibold">Stock Quantity</label>
                        <input asp-for="StockQuantity" type="number" class="form-control form-control-custom font-monospace" min="0" required />
                        <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="CoverImageUrl" class="form-label text-muted fw-semibold">Cover Image URL</label>
                        <input asp-for="CoverImageUrl" class="form-control form-control-custom" />
                        <span asp-validation-for="CoverImageUrl" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label text-muted fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control form-control-custom" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-12 mt-4 pt-2 border-top border-secondary text-end">
                        <a asp-action="Index" class="btn btn-secondary-outline me-2">Cancel</a>
                        <button type="submit" class="btn btn-primary-gradient px-4 fw-bold">
                            <i class="bi bi-save me-1"></i> Update Book
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
