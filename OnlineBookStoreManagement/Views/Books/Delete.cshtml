@model OnlineBookStoreManagement.Models.Book
@{
    ViewData["Title"] = $"Delete - {Model.Title}";
}

<div class="row justify-content-center py-4">
    <div class="col-md-7 col-lg-6">
        <div class="card bg-card border-danger shadow-lg p-4 p-md-5 text-center">
            <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-25 text-danger rounded-circle p-3 mb-3 mx-auto" style="width: 70px; height: 70px;">
                <i class="bi bi-exclamation-triangle display-5"></i>
            </div>

            <h3 class="fw-bold text-white mb-2">Delete Book</h3>
            <p class="text-muted mb-4">Are you sure you want to delete this book from the catalog? This action cannot be undone.</p>

            <div class="bg-dark p-3 rounded border border-secondary text-start mb-4">
                <h5 class="fw-bold text-white mb-1">@Model.Title</h5>
                <p class="text-muted small mb-2">by @Model.Author</p>
                <div class="d-flex justify-content-between text-muted small">
                    <span>Category: <strong class="text-light">@(Model.Category?.Name ?? "Unassigned")</strong></span>
                    <span>Price: <strong class="text-accent font-monospace">₹@Model.Price.ToString("N2")</strong></span>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="d-flex gap-2 justify-content-center">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn btn-secondary-outline px-4">Cancel</a>
                <button type="submit" class="btn btn-danger px-4 fw-bold">
                    <i class="bi bi-trash me-1"></i> Yes, Delete Book
                </button>
            </form>
        </div>
    </div>
</div>
