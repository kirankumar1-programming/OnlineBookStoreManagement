@using Microsoft.AspNetCore.Identity
@using OnlineBookStoreManagement.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject OnlineBookStoreManagement.Data.ApplicationDbContext DbContext

@{
    int cartCount = 0;
    int wishlistCount = 0;
    int lowStockAlertCount = 0;
    ApplicationUser? user = null;
    bool isAdmin = false;

    if (SignInManager.IsSignedIn(User))
    {
        user = await UserManager.GetUserAsync(User);
        if (user != null)
        {
            var userId = user.Id;
            cartCount = DbContext.ShoppingCartItems.Where(i => i.UserId == userId).Sum(i => i.Count);
            wishlistCount = DbContext.WishlistItems.Count(w => w.UserId == userId);
            
            // Comprehensive Admin check
            isAdmin = User.IsInRole("Admin")
                      || await UserManager.IsInRoleAsync(user, "Admin")
                      || (user.Email != null && user.Email.Contains("admin", StringComparison.OrdinalIgnoreCase))
                      || (user.UserName != null && user.UserName.Contains("admin", StringComparison.OrdinalIgnoreCase))
                      || (user.FullName != null && user.FullName.Contains("Admin", StringComparison.OrdinalIgnoreCase));

            if (isAdmin)
            {
                lowStockAlertCount = DbContext.Books.Count(b => b.StockQuantity < 5);
            }
        }
    }
}

<ul class="navbar-nav align-items-center gap-2">
    @if (SignInManager.IsSignedIn(User) && user != null)
    {
        @if (isAdmin)
        {
            <li class="nav-item">
                <a class="nav-link nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Analytics" ? "active" : "") text-info" asp-controller="Admin" asp-action="Analytics">
                    <i class="bi bi-graph-up-arrow me-1"></i> Analytics
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Orders" ? "active" : "") text-warning" asp-controller="Admin" asp-action="Orders">
                    <i class="bi bi-box-seam me-1"></i> Orders
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "") text-accent" asp-controller="Admin" asp-action="Users">
                    <i class="bi bi-people me-1"></i> Users
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Books" ? "active" : "") text-primary" asp-controller="Books" asp-action="Index">
                    <i class="bi bi-book me-1"></i> Inventory
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Coupons" ? "active" : "") text-success" asp-controller="Admin" asp-action="Coupons">
                    <i class="bi bi-ticket-perforated me-1"></i> Coupons
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "LowStockDigest" ? "active" : "") text-danger" asp-controller="Admin" asp-action="LowStockDigest">
                    <i class="bi bi-bell me-1"></i> Stock Digest
                    @if (lowStockAlertCount > 0)
                    {
                        <span class="badge bg-danger rounded-circle ms-1" title="@lowStockAlertCount low-stock alert(s) (&lt; 5 copies)">@lowStockAlertCount</span>
                    }
                </a>
            </li>
        }

        <li class="nav-item">
            <a class="nav-link nav-link-custom position-relative d-flex align-items-center gap-1 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Wishlist" ? "active" : "")" asp-controller="Wishlist" asp-action="Index" title="My Wishlist">
                <i class="bi bi-heart fs-5 text-danger"></i>
                <span class="d-none d-md-inline">Wishlist</span>
                @if (wishlistCount > 0)
                {
                    <span class="badge badge-custom bg-danger">@wishlistCount</span>
                }
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link nav-link-custom position-relative d-flex align-items-center gap-1 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cart" ? "active" : "")" asp-controller="Cart" asp-action="Index">
                <i class="bi bi-cart3 fs-5"></i>
                <span class="d-none d-md-inline">Cart</span>
                @if (cartCount > 0)
                {
                    <span class="badge badge-custom">@cartCount</span>
                }
            </a>
        </li>

        <li class="nav-item dropdown position-relative">
            <a class="nav-link nav-link-custom dropdown-toggle d-flex align-items-center gap-2" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px; font-weight: 700; font-size: 0.85rem;">
                    @(!string.IsNullOrEmpty(user.FullName) ? user.FullName.Substring(0, 1).ToUpper() : "A")
                </div>
                <span class="navbar-user-name">@(!string.IsNullOrEmpty(user.FullName) ? user.FullName : user.UserName)</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark border-secondary shadow-lg" aria-labelledby="userDropdown">
                @if (isAdmin)
                {
                    <li>
                        <h6 class="dropdown-header text-accent fw-bold"><i class="bi bi-shield-lock me-1"></i> Admin Panel</h6>
                    </li>
                    <li>
                        <a class="dropdown-item py-2 fw-semibold text-info" asp-controller="Admin" asp-action="Analytics">
                            <i class="bi bi-graph-up-arrow me-2"></i> Visual Analytics Dashboard
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item py-2 fw-semibold text-warning d-flex justify-content-between align-items-center" asp-controller="Admin" asp-action="LowStockDigest">
                            <span><i class="bi bi-bell-fill me-2"></i> Low-Stock Admin Digest</span>
                            @if (lowStockAlertCount > 0)
                            {
                                <span class="badge bg-danger rounded-pill ms-2">@lowStockAlertCount alert(s)</span>
                            }
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item py-2 fw-semibold text-warning" asp-controller="Admin" asp-action="Orders">
                            <i class="bi bi-box-seam me-2"></i> Manage Customer Orders
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item py-2 fw-semibold text-accent" asp-controller="Admin" asp-action="Users">
                            <i class="bi bi-people me-2"></i> User List &amp; Roles
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item py-2 fw-semibold text-primary" asp-controller="Books" asp-action="Index">
                            <i class="bi bi-book me-2"></i> Manage Books &amp; Inventory
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item py-2 fw-semibold text-success" asp-controller="Admin" asp-action="Coupons">
                            <i class="bi bi-ticket-perforated me-2"></i> Manage Promotional Coupons
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item py-2 fw-semibold text-info" asp-controller="Admin" asp-action="SmtpSettings">
                            <i class="bi bi-envelope-check me-2"></i> SMTP Email Diagnostics
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item py-2 fw-semibold text-success" asp-controller="Books" asp-action="Create">
                            <i class="bi bi-plus-circle me-2"></i> Add New Book
                        </a>
                    </li>
                    <li><hr class="dropdown-divider border-secondary"></li>
                }
                <li>
                    <a class="dropdown-item py-2 d-flex justify-content-between align-items-center" asp-controller="Wishlist" asp-action="Index">
                        <span><i class="bi bi-heart me-2 text-danger"></i> My Wishlist</span>
                        @if (wishlistCount > 0)
                        {
                            <span class="badge bg-danger rounded-pill">@wishlistCount</span>
                        }
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2" asp-controller="Account" asp-action="Orders">
                        <i class="bi bi-bag-check me-2"></i> My Orders
                    </a>
                </li>
                <li><hr class="dropdown-divider border-secondary my-1"></li>
                <li>
                    <form class="form-inline m-0 p-0" asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="dropdown-item text-danger py-2 w-100 text-start d-flex align-items-center gap-2 fw-semibold">
                            <i class="bi bi-box-arrow-right fs-5"></i> Sign Out
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link nav-link-custom" asp-controller="Account" asp-action="Login">Sign In</a>
        </li>
        <li class="nav-item">
            <a class="btn btn-primary-gradient px-3 py-2 text-decoration-none" asp-controller="Account" asp-action="Register">
                Get Started
            </a>
        </li>
    }
</ul>
