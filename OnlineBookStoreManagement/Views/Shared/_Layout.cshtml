<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>@ViewData["Title"] - MyBookStore</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chatbot.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container-fluid max-w-7xl mx-auto px-lg-4">
                <a class="navbar-brand navbar-brand-logo" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book-half"></i>
                    <span>MyBookStore</span>
                </a>
                <button class="navbar-toggler border-secondary text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse mt-3 mt-lg-0" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-grid me-1"></i> Catalog
                            </a>
                        </li>
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>

        <!-- Sub-Navbar Live Search Bar (Aligned Below Menu) -->
        <div class="search-bar-row py-2 border-bottom border-secondary shadow-sm">
            <div class="container-fluid max-w-7xl mx-auto px-lg-4">
                <div class="navbar-search-container position-relative w-100" id="navbarSearchContainer">
                    <form method="get" asp-controller="Home" asp-action="Index" id="navbarSearchForm" role="search" autocomplete="off">
                        <div class="input-group rounded-pill overflow-hidden border border-secondary bg-dark shadow-sm">
                            <span class="input-group-text bg-transparent border-0 text-muted ps-3">
                                <i class="bi bi-search" id="navbarSearchIcon"></i>
                                <span class="spinner-border spinner-border-sm text-primary d-none" id="navbarSearchSpinner" role="status" aria-hidden="true"></span>
                            </span>
                            <input type="text" id="navbarSearchInput" name="searchTerm" class="form-control bg-transparent text-light border-0 shadow-none px-2 py-2" placeholder="Search books by title, author, ISBN..." aria-label="Search books" autocomplete="off" />
                            <button type="button" id="navbarSearchClear" class="btn btn-link text-muted p-0 me-2 text-decoration-none d-none" aria-label="Clear search">
                                <i class="bi bi-x-circle-fill"></i>
                            </button>
                            <button type="submit" class="btn btn-primary-gradient px-4 border-0 rounded-pill my-1 me-1">
                                <i class="bi bi-search d-sm-none"></i>
                                <span class="d-none d-sm-inline fw-bold">Search</span>
                            </button>
                        </div>
                    </form>

                    <!-- Auto-complete Dropdown -->
                    <div id="navbarSearchResults" class="navbar-search-dropdown shadow-lg rounded-3 d-none" tabindex="-1">
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main role="main" class="container-fluid px-lg-4 py-4 flex-grow-1">
        <partial name="_Notification" />
        <partial name="_LowStockAdminAlert" />
        @RenderBody()
    </main>

    <partial name="_ChatbotPartial" />

    <footer>
        <div class="container text-center">
            <p class="mb-1 fw-semibold text-light">&copy; @DateTime.UtcNow.Year MyBookStore Management System. Built with ASP.NET Core &amp; EF Core.</p>
            <small class="text-muted">Designed for fast, secure &amp; seamless online bookstore management.</small>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/chatbot.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
