@model ErrorViewModel
@{
    ViewData["Title"] = "Error " + Model.StatusCode;
    var errorMessage = ViewData["ErrorMessage"] as string ?? Model.ErrorMessage ?? "An unexpected error occurred while processing your request.";
    var statusCode = Model.StatusCode;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card bg-dark border-secondary shadow-lg rounded-4 overflow-hidden p-4 p-md-5 text-light text-center">
                <div class="mb-4">
                    <div class="d-inline-flex p-4 rounded-circle bg-danger bg-opacity-10 text-danger mb-3">
                        @if (statusCode == 404)
                        {
                            <i class="bi bi-file-earmark-x display-3"></i>
                        }
                        else if (statusCode == 403)
                        {
                            <i class="bi bi-shield-lock display-3 text-warning"></i>
                        }
                        else
                        {
                            <i class="bi bi-exclamation-triangle-fill display-3"></i>
                        }
                    </div>
                    <h1 class="display-5 fw-bold mb-2">
                        @if (statusCode == 404)
                        {
                            <span>Page Not Found</span>
                        }
                        else if (statusCode == 403)
                        {
                            <span>Access Denied</span>
                        }
                        else
                        {
                            <span>Something Went Wrong</span>
                        }
                    </h1>
                    <p class="lead text-muted max-w-xl mx-auto mb-4">
                        @errorMessage
                    </p>
                </div>

                <div class="d-flex flex-wrap gap-3 justify-content-center mb-4">
                    <a href="/" class="btn btn-primary-gradient px-4 py-2 rounded-pill fw-semibold shadow-sm">
                        <i class="bi bi-house-door me-2"></i>Return to Home
                    </a>
                    <a href="/Home/Index" class="btn btn-outline-light px-4 py-2 rounded-pill fw-semibold">
                        <i class="bi bi-book me-2"></i>Browse Catalog
                    </a>
                    <button type="button" onclick="history.back()" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                        <i class="bi bi-arrow-left me-2"></i>Go Back
                    </button>
                </div>

                @if (Model.ShowRequestId || ViewData["ExceptionDetails"] != null)
                {
                    <div class="accordion border-secondary mt-3 text-start" id="errorDiagnosticsAccordion">
                        <div class="accordion-item bg-dark-subtle border-secondary rounded-3 overflow-hidden">
                            <h2 class="accordion-header" id="headingDetails">
                                <button class="accordion-button collapsed bg-dark-subtle text-muted small py-2 px-3 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDetails" aria-expanded="false" aria-controls="collapseDetails">
                                    <i class="bi bi-terminal me-2"></i>Technical Diagnostic Details
                                </button>
                            </h2>
                            <div id="collapseDetails" class="accordion-collapse collapse" aria-labelledby="headingDetails" data-bs-parent="#errorDiagnosticsAccordion">
                                <div class="accordion-body small text-muted font-monospace bg-black bg-opacity-25 p-3">
                                    @if (Model.ShowRequestId)
                                    {
                                        <p class="mb-1"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.ErrorPath))
                                    {
                                        <p class="mb-1"><strong>Request Path:</strong> <code>@Model.ErrorPath</code></p>
                                    }
                                    <p class="mb-1"><strong>Status Code:</strong> <code>@Model.StatusCode</code></p>
                                    @if (ViewData["ExceptionDetails"] != null)
                                    {
                                        <div class="mt-2 pt-2 border-top border-secondary">
                                            <strong>Exception Stack Trace:</strong>
                                            <pre class="text-danger small mt-1 p-2 bg-dark rounded" style="white-space: pre-wrap; word-break: break-all;">@ViewData["ExceptionDetails"]</pre>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
