@using OnlineBookStoreManagement.Models.ViewModels


@model ShoppingCartViewModel
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="fw-bold text-white mb-0"><i class="bi bi-cart3 me-2 text-primary"></i> Shopping Cart</h2>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary-outline btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Continue Shopping
    </a>
</div>

@if (!Model.CartItems.Any())
{
    <div class="card p-5 text-center bg-card border-secondary shadow-lg my-4">
        <i class="bi bi-cart-x display-1 text-muted mb-3"></i>
        <h3 class="text-white">Your Shopping Cart is Empty</h3>
        <p class="text-muted">Looks like you haven't added any books to your cart yet.</p>
        <div class="mt-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary-gradient px-4 py-2">
                Explore Bookstore Catalog
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <!-- Cart Items List -->
        <div class="col-lg-8">
            <div class="card bg-card border-secondary shadow-lg overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-custom mb-0">
                        <thead>
                            <tr>
                                <th>Book Item</th>
                                <th class="text-center">Price</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-end">Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.CartItems)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@(string.IsNullOrEmpty(item.Book?.CoverImageUrl) ? "https://via.placeholder.com/60x80" : item.Book.CoverImageUrl)" 
                                                 alt="@item.Book?.Title" class="rounded border border-secondary" style="width: 50px; height: 65px; object-fit: cover;" />
                                            <div>
                                                <h6 class="fw-bold text-white mb-1">@item.Book?.Title</h6>
                                                <small class="text-muted">by @item.Book?.Author</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center fw-semibold text-light">₹@item.Book?.Price.ToString("N2")</td>
                                    <td class="text-center">
                                        <div class="d-inline-flex align-items-center gap-2 bg-dark p-1 rounded border border-secondary">
                                            <form asp-action="Minus" method="post">
                                                <input type="hidden" name="cartId" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-link text-light p-0 px-2 text-decoration-none">-</button>
                                            </form>
                                            <span class="fw-bold text-white px-2">@item.Count</span>
                                            <form asp-action="Plus" method="post">
                                                <input type="hidden" name="cartId" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-link text-light p-0 px-2 text-decoration-none">+</button>
                                            </form>
                                        </div>
                                    </td>
                                    <td class="text-end fw-bold text-accent">₹@item.Price.ToString("N2")</td>
                                    <td class="text-end">
                                        <form asp-action="Remove" method="post">
                                            <input type="hidden" name="cartId" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm text-danger hover-white border-0 bg-transparent" title="Remove Item">
                                                <i class="bi bi-trash fs-5"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Cart Summary Card -->
        <div class="col-lg-4">
            <div class="card bg-card border-secondary shadow-lg p-4">
                <h5 class="fw-bold text-white mb-4"><i class="bi bi-receipt me-2 text-primary"></i> Order Summary</h5>
                
                <div class="d-flex justify-content-between mb-3 text-muted">
                    <span>Subtotal (@Model.CartItems.Sum(i => i.Count) items)</span>
                    <span class="text-light font-monospace">₹@Model.SubTotal.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between mb-3 text-muted">
                    <span>Estimated GST / Tax (8%)</span>
                    <span class="text-light font-monospace">₹@Model.EstimatedTax.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between mb-3 text-muted">
                    <span>Shipping</span>
                    @if (Model.ShippingFee == 0)
                    {
                        <span class="text-success fw-bold">FREE</span>
                    }
                    else
                    {
                        <span class="text-light font-monospace">₹@Model.ShippingFee.ToString("N2")</span>
                    }
                </div>

                @if (Model.SubTotal < 999.00m && Model.SubTotal > 0)
                {
                    <div class="alert alert-info py-2 px-3 small border-0 bg-dark text-info mb-3">
                        <i class="bi bi-info-circle me-1"></i> Add <strong>₹@((999.00m - Model.SubTotal).ToString("N2"))</strong> more to qualify for FREE shipping!
                    </div>
                }

                <hr class="border-secondary my-3" />

                <div class="d-flex justify-content-between mb-4">
                    <span class="fs-5 fw-bold text-white">Grand Total</span>
                    <span class="fs-4 fw-extrabold text-accent font-monospace">₹@Model.GrandTotal.ToString("N2")</span>
                </div>

                <a asp-action="Checkout" class="btn btn-primary-gradient w-100 py-3 fw-bold fs-6">
                    Proceed to Checkout <i class="bi bi-credit-card ms-2"></i>
                </a>
            </div>
        </div>
    </div>
}

